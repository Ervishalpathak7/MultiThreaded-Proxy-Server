# Generated by bench/run.sh for one benchmark run. Do not edit; see run.sh.
workers @WORKERS@;
log_level warn;          # the per-request access log (info) would dominate the profile

listen @HTTP_PORT@;
listen @TLS_PORT@ ssl;
@H3_LINE@

ssl_certificate     @ROOT@/certs/server.crt;
ssl_certificate_key @ROOT@/certs/server.key;

max_header_size 16k;
max_body_size   8m;
header_timeout  30s;
idle_timeout    120s;

upstream origin {
    strategy round_robin;
    server 127.0.0.1:@ORIGIN1@;
    server 127.0.0.1:@ORIGIN2@;
    health_check interval=5s path=/health;
    connect_timeout 2s;
    read_timeout    30s;
    keepalive       256;
}

cache {
    max_size    512m;
    default_ttl 300s;
    shards      64;
}

route /    { proxy_pass origin; cache on;  }
route /api { proxy_pass origin; cache off; }
